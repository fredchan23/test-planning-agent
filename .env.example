# Local Authentication & API Routing Configuration

# Set to "True" to use Google Vertex AI (Enterprise) or "False" to use Google AI Studio (Gemini API Key)
GOOGLE_GENAI_USE_ENTERPRISE="True"

# --- Enterprise Configuration (if GOOGLE_GENAI_USE_ENTERPRISE="True") ---
# The Google Cloud project ID containing your enabled Vertex AI APIs
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
# The Google Cloud location (e.g. "global" or a specific region like "us-east1")
GOOGLE_CLOUD_LOCATION="global"

# --- Developer Configuration (if GOOGLE_GENAI_USE_ENTERPRISE="False") ---
# Your API key from Google AI Studio (needed for gemini models)
# GEMINI_API_KEY="your-gemini-api-key"
